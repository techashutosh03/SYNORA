def run_all():
    print(BANNER)
    print(f"{CYAN}🚀 Launching complete SYNORA AI + OmniRoute ecosystem...{RESET}")
    print(f"  • {BOLD}OmniRoute Gateway:{RESET} http://localhost:20128/v1 (376 AI Providers)")
    print(f"  • {BOLD}SYNORA Backend:{RESET}    http://localhost:8000 (FastAPI Orchestrator)")
    print(f"  • {BOLD}Claw Code Harness:{RESET} Active (12 autonomous tools & Studio)")
    print(f"  • {BOLD}SYNORA Web UI:{RESET}     http://localhost:5173 (Chat & Claw Studio)")
    print(f"{DIM}Press Ctrl+C to stop all services cleanly.{RESET}\n")

    # Ensure OmniRoute is online or already pre-warmed
    try:
        from backend.core.omniroute_process import omniroute_process_manager
        if not omniroute_process_manager.is_listening():
            print(f"{CYAN}⚡ Pre-warming OmniRoute AI Gateway on port 20128...{RESET}")
            omniroute_process_manager.start_background(wait_seconds=6.0)
    except Exception as e:
        pass

    cmd = [
        "npx", "--yes", "concurrently",
        "-k",
        "-n", "omniroute,backend,frontend",
        "-c", "blue,green,magenta",
        "npm run dev",
        f"{sys.executable} -m uvicorn backend.main:app --port 8000 --reload",
        "npm --prefix frontend run dev"
    ]
    try:
        subprocess.run(cmd, cwd=str(root))
    except KeyboardInterrupt:
        print(f"\n{YELLOW}🛑 All services stopped cleanly. Goodbye!{RESET}")

def run_backend():
    print(f"{GREEN}🚀 Starting SYNORA FastAPI Backend on port 8000...{RESET}")
    try:
        from backend.core.omniroute_process import omniroute_process_manager
        omniroute_process_manager.start_background(wait_seconds=15.0)
    except Exception as e:
        print(f"{YELLOW}⚠️ Could not auto-check OmniRoute: {e}{RESET}")
    cmd = [sys.executable, "-m", "uvicorn", "backend.main:app", "--port", "8000", "--reload"]
    subprocess.run(cmd, cwd=str(root))

def run_omniroute():
    print(f"{CYAN}⚡ Starting OmniRoute AI Gateway on port 20128...{RESET}")
    cmd = ["npm", "run", "dev"]
    subprocess.run(cmd, cwd=str(root))

def run_frontend():
    print(f"{MAGENTA}🎨 Starting SYNORA Web UI on port 5173...{RESET}")
    cmd = ["npm", "run", "dev"]
    subprocess.run(cmd, cwd=str(root / "frontend"))

def run_claw():
    try:
        from backend.core.omniroute_process import omniroute_process_manager
        omniroute_process_manager.start_background(wait_seconds=15.0)
    except Exception:
        pass
    from backend.agent.cli import main
    sys.argv.pop(1)
    main()

def run_doctor():
    import asyncio
    from backend.agent.commands import slash_command_registry
    res = asyncio.run(slash_command_registry.cmd_doctor())
    print(f"\n{GREEN}{res.output}{RESET}\n")

if __name__ == "__main__":
    if len(sys.argv) == 1:
        run_all()
    else:
        subcmd = sys.argv[1].lower()
        if subcmd in ("all", "dev", "start"):
            run_all()
        elif subcmd in ("claw", "agent"):
            run_claw()
        elif subcmd in ("backend", "server", "api"):
            run_backend()
        elif subcmd in ("omniroute", "proxy", "gateway"):
            run_omniroute()
        elif subcmd in ("frontend", "ui", "web"):
            run_frontend()
        elif subcmd in ("doctor", "/doctor"):
            run_doctor()
        elif subcmd in ("help", "--help", "-h"):
            print_help()
        else:
            # If argument does not match command, pass through to Claw Code
            from backend.agent.cli import main
            main()
