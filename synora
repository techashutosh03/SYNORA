def print_help():
    print(BANNER)
    print(f"""{BOLD}Usage:{RESET} ./synora [command] [options]

{BOLD}Commands:{RESET}
  {GREEN}all{RESET} | {GREEN}dev{RESET}        Start the full stack: OmniRoute (20128) + SYNORA Backend (8000) + Frontend (5173)
  {GREEN}claw{RESET} [task]       Launch Claw Code autonomous coding agent (CLI / REPL)
  {GREEN}doctor{RESET}            Run preflight diagnostics across OmniRoute, Ollama, Node, and Python
  {GREEN}omniroute{RESET}         Start only OmniRoute AI Proxy Gateway (port 20128)
  {GREEN}backend{RESET}           Start only SYNORA FastAPI backend server (port 8000)
  {GREEN}frontend{RESET}          Start only SYNORA Web UI & Claw Studio (port 5173)
